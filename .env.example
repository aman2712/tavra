# Linq Partner API V3 bearer token.
LINQ_API_KEY=

# live verifies every webhook. mock accepts unsigned local fixture requests.
LINQ_MODE=live

# Linq number in E.164 format, for example +12025551234.
LINQ_FROM_NUMBER=

# Returned once when the webhook subscription is created.
LINQ_WEBHOOK_SECRET=

# Public HTTPS origin that forwards to PORT (dev tunnel, ngrok, etc.).
PUBLIC_BASE_URL=

# OpenAI API key used only by the server-side Responses API client.
OPENAI_API_KEY=

# Optional model override. Defaults to GPT-5 mini for concise, cost-efficient replies.
OPENAI_MODEL=gpt-5-mini

# Optional low-cost intent router. Greetings bypass classification entirely.
OPENAI_ROUTER_MODEL=gpt-4o-mini

# Senso API key used to retrieve allowlisted company context.
SENSO_API_KEY=

# Optional. Defaults to Senso's current v2 organization API.
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1/

# Private, gitignored exact phone-to-employee mapping.
SENSO_IDENTITY_MAP_PATH=senso/demo-config/identity-map.local.json

# Private employee profile source used by the Senso sync command.
SENSO_PRIVATE_PROFILE_PATH=senso/demo-config/employee-profile.local.md

# Prava sandbox credentials. The secret key is server-side only.
PRAVA_API_KEY=pk_test_your_publishable_key
PRAVA_SECRET_KEY=sk_test_your_secret_key
PRAVA_MODE=sandbox
PRAVA_BACKEND_URL=https://sandbox.api.prava.space
PRAVA_CHECKOUT_MODE=hosted

# Optional. Once the signed Tavra Messages extension is installed, set the exact
# Apple Team ID and extension bundle ID to replace the ordinary rich link with an
# interactive Linq iMessage app card. Keep the team ID empty until then.
TAVRA_MESSAGES_APP_TEAM_ID=
TAVRA_MESSAGES_APP_BUNDLE_ID=com.yourcompany.tavra.MessagesExtension
TAVRA_MESSAGES_APP_NAME=Tavra
# TAVRA_MESSAGES_APP_STORE_ID is only needed after App Store publication.
TAVRA_MESSAGES_APP_STORE_ID=

PORT=3000
